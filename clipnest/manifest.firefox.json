{
  "manifest_version": 2,
  "name": "ClipNest",
  "version": "1.0.0",
  "description": "Local clipboard history for copied text, links, and image references.",
  "permissions": ["storage", "notifications", "activeTab", "<all_urls>"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }],
  "background": { "scripts": ["background.js"] },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "ClipNest",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
